---
import { locales, localeName, localeShort, htmlLang, localizePath, type Locale } from "../i18n/config";
import { t } from "../i18n";

interface Props {
  locale: Locale;
  neutralPath: string;
}
const { locale, neutralPath } = Astro.props;
---

<details class="lang" data-dismissable>
  <summary aria-label={`${t(locale, "lang.label")}: ${localeName[locale]}`}>
    <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M1.5 8h13M8 1.5c2 2.2 2 10.8 0 13M8 1.5c-2 2.2-2 10.8 0 13" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>
    <span>{localeShort[locale]}</span>
    <svg class="chev" viewBox="0 0 10 10" width="8" height="8" aria-hidden="true"><path d="M2 4l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  </summary>
  <ul role="list">
    {locales.map((l) => (
      <li>
        <a href={localizePath(neutralPath, l)} hreflang={htmlLang[l]} lang={htmlLang[l]} aria-current={l === locale ? "true" : undefined}>
          <span>{localeName[l]}</span>
          {l === locale && <span class="check" aria-hidden="true">✓</span>}
        </a>
      </li>
    ))}
  </ul>
</details>

<style>
  .lang {
    position: relative;
    flex-shrink: 0;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 0 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ink) 7%, transparent);
    color: var(--ink-2);
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { border-radius: 999px; }
  .chev { transition: transform var(--dur-base) var(--ease-apple); }
  .lang[open] .chev { transform: rotate(180deg); }
  ul {
    position: absolute;
    right: 0;
    top: calc(100% + 8px);
    z-index: 60;
    min-width: 168px;
    margin: 0;
    padding: 6px;
    list-style: none;
    border-radius: 14px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }
  a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 40px;
    padding: 0 12px;
    border-radius: 9px;
    color: var(--ink-2);
    font-size: 14px;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-apple), color var(--dur-fast) var(--ease-apple);
  }
  a:hover { background: var(--panel); color: var(--ink); }
  a[aria-current="true"] { color: var(--ink); font-weight: 600; }
  .check { color: var(--accent-ink); }
</style>
