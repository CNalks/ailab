---
import SeriesChart from "./SeriesChart.astro";
import type { SeriesResult, Source, Manifest } from "../lib/data";
import { asset, msgKey, type Locale } from "../i18n/config";
import { t, tMaybe, type MessageKey } from "../i18n";
import { formatDate, formatNumber } from "../i18n/format";

interface Props { id: string; res: SeriesResult; source?: Source; locale: Locale; entry?: Manifest["series"][number] }
const { id, res, source, locale, entry } = Astro.props;
const k = (suffix: string) => `s.${id}.${suffix}` as MessageKey;
const mk = msgKey[locale];
const dec = res.gate.decision;
const gateLabel = t(locale, `gate.${dec}` as MessageKey);
const limits = res.gate.limits;
const gateSub =
  dec === "limited"
    ? t(locale, "gate.limited.s", { h: limits.max_horizon_weeks ?? res.policy.horizon_weeks, infl: limits.interval_inflation })
    : t(locale, `gate.${dec}.s` as MessageKey);
const isInt = res.series.indicator_type !== "proportion";
const fmt = (v: number | null | undefined) => formatNumber(locale, v, isInt ? 0 : 2);
const unit = res.series.indicator_type === "proportion" ? "%" : "";
const model = res.forecast ? tMaybe(locale, `model.${res.policy.model_family}`, res.policy.model_family) : null;
const bt = res.backtest;
const rel = bt?.models?.[bt.chosen_model]?.rel_mae_vs_seasonal_naive;
const alerts = res.alerts.map((a) => ({ ...a, label: tMaybe(locale, `method.${a.method}`, a.method) }));
const lastRows = res.observations.slice(-12);
const fcRows = res.forecast?.points ?? [];
const dl = entry?.download ? asset(`/data/${entry.download}`) : null;
const SRC_LABEL: Record<string, string> = { cdc_fluview: "US CDC · FluView (via Delphi Epidata)", ukhsa_dashboard: "UKHSA data dashboard", ecdc_erviss: "ECDC · ERVISS" };
const dj = asset(`/data/series/${id}.json`);
---

<article class="card" id={`s-${id}`} data-gate={dec} aria-labelledby={`h-${id}`}>
  <header class="head">
    <div>
      <p class="geo">{t(locale, k("g"))}</p>
      <h3 id={`h-${id}`}>{t(locale, k("n"))}</h3>
    </div>
    <span class="gate" data-gate={dec}>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        {dec === "allowed" && <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
        {dec === "limited" && <path d="M8 2.5a5.5 5.5 0 100 11z" fill="currentColor" />}
        {dec === "limited" && <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" />}
        {dec === "refused" && <path d="M4 8h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />}
      </svg>
      {t(locale, "series.gate")}: {gateLabel}
    </span>
  </header>
  <p class="desc">{t(locale, k("d"))}{id === "malta_flu_detections" && <em class="tag">{t(locale, "series.refused.tag")}</em>}</p>

  <div class="chartbox">
    <SeriesChart res={res} locale={locale} name={t(locale, k("n"))} gateLabel={gateLabel} />
    {!res.forecast && <p class="nofc">{t(locale, "series.noforecast")}</p>}
  </div>
  <ul class="legend" role="list">
    <li><i class="k hist"></i>{t(locale, "chart.history")}</li>
    {res.forecast && <li><i class="k fc"></i>{t(locale, "chart.forecast")}</li>}
    {res.forecast && <li><i class="k band"></i>{t(locale, "chart.band80")} / {t(locale, "chart.band95")}</li>}
    <li><i class="k tick"></i>{t(locale, "chart.signals")}</li>
    {res.quality.n_missing > 0 && res.series.series_id === "malta_flu_detections" && <li><i class="k gap"></i>{t(locale, "chart.missing")}</li>}
  </ul>

  <dl class="facts">
    <div><dt>{t(locale, "series.through")}</dt><dd class="num">{formatDate(locale, res.data_through)}</dd></div>
    <div><dt>{t(locale, "series.gate")}</dt><dd>{gateSub}</dd></div>
    <div class="wide">
      <dt>{t(locale, "series.reasons")}</dt>
      <dd>
        {res.gate.reasons.length === 0 ? t(locale, "series.noreasons") : (
          <ul role="list" class="reasons">
            {res.gate.reasons.map((r) => (<li><code>{r.code}</code> {r.message[mk]}</li>))}
          </ul>
        )}
      </dd>
    </div>
    {res.gate.recommended_action.code !== "none" && (
      <div class="wide"><dt>{t(locale, "series.action")}</dt><dd>{res.gate.recommended_action.message[mk]}</dd></div>
    )}
    {model && <div><dt>{t(locale, "series.model")}</dt><dd>{model}</dd></div>}
    {res.forecast && <div><dt>{t(locale, "series.horizon")}</dt><dd>{t(locale, "series.horizonv", { h: res.policy.horizon_weeks })}</dd></div>}
    {bt && (
      <div class="wide"><dt>{t(locale, "series.backtest")}</dt>
        <dd>{rel != null ? t(locale, "series.backtestv", { n: bt.n_windows, seasons: formatNumber(locale, bt.seasons_covered, 1), rel: formatNumber(locale, rel, 2) }) : t(locale, "series.backtestn", { n: bt.n_windows, seasons: formatNumber(locale, bt.seasons_covered, 1) })}</dd></div>
    )}
    {alerts.length > 0 && (
      <div class="wide"><dt>{t(locale, "series.signals")}</dt>
        <dd>{alerts.map((a, i) => (<span>{i > 0 && " · "}{t(locale, "series.signalsv", { method: a.label, n: a.n_signals })}</span>))}</dd></div>
    )}
    <div><dt>{t(locale, "series.source")}</dt><dd>{source ? (<a href={source.docs_url}>{SRC_LABEL[source.source_id] ?? source.source_id}</a>) : res.series.source_id}</dd></div>
    <div><dt>{t(locale, "series.download")}</dt><dd><a href={dj}>JSON</a>{dl && <> · <a href={dl}>Parquet</a></>}</dd></div>
  </dl>

  <details class="tbl">
    <summary>{t(locale, "series.table")}</summary>
    <div class="scroll" tabindex="0" role="region" aria-label={t(locale, k("n"))}>
      <table>
        <thead>
          <tr>
            <th scope="col">{t(locale, "tbl.week")}</th><th scope="col">{t(locale, "tbl.obs")}</th>
            {fcRows.length > 0 && <><th scope="col">{t(locale, "tbl.fc")}</th><th scope="col">{t(locale, "tbl.r80")}</th><th scope="col">{t(locale, "tbl.r95")}</th></>}
          </tr>
        </thead>
        <tbody>
          {lastRows.map((r) => (<tr><th scope="row" class="num">{r.ds}</th><td class="num">{r.y == null ? "–" : fmt(r.y) + unit}</td>{fcRows.length > 0 && <><td></td><td></td><td></td></>}</tr>))}
          {fcRows.map((p) => (
            <tr class="fcrow"><th scope="row" class="num">{p.ds}</th><td></td><td class="num">{fmt(p.point)}{unit}</td>
              <td class="num">{p.lo80 != null ? `${fmt(p.lo80)}–${fmt(p.hi80)}${unit}` : "–"}</td>
              <td class="num">{p.lo95 != null ? `${fmt(p.lo95)}–${fmt(p.hi95)}${unit}` : "–"}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</article>

<style>
  .card {
    padding: clamp(18px, 3vw, 32px);
    border-radius: var(--radius-lg);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .head { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-4); justify-content: space-between; align-items: flex-start; }
  .geo { color: var(--muted); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; }
  h3 { font-size: var(--text-xl); letter-spacing: -0.015em; margin-top: 2px; }
  .gate {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px;
    font-size: 13px; font-weight: 600; white-space: nowrap; border: 1px solid transparent;
  }
  /* gate states are never red / amber / green: teal = data ok, indigo = limited, grey = refused */
  .gate[data-gate="allowed"] { color: var(--on-data); background: var(--data); }
  .gate[data-gate="limited"] { color: var(--indigo); background: color-mix(in srgb, var(--indigo) 12%, transparent); border-color: color-mix(in srgb, var(--indigo) 40%, transparent); }
  .gate[data-gate="refused"] { color: var(--ink-2); background: var(--panel); border-color: var(--line-strong); }
  .desc { margin-top: var(--s-3); color: var(--ink-2); max-width: 70ch; }
  .tag { margin-left: 8px; padding: 2px 8px; border-radius: 6px; font-style: normal; font-size: 12px; font-weight: 600; color: var(--ink-2); background: var(--panel); border: 1px dashed var(--line-strong); white-space: nowrap; }
  .chartbox { position: relative; margin-top: var(--s-5); }
  .nofc { margin-top: var(--s-2); color: var(--muted); font-size: var(--text-sm); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: var(--s-3) 0 0; padding: 0; list-style: none; color: var(--muted); font-size: 12px; }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .k { display: inline-block; width: 18px; height: 0; border-top: 2px solid var(--data); }
  .k.fc { border-top: 2px dashed var(--forecast); }
  .k.band { height: 10px; width: 18px; border: 0; border-radius: 3px; background: color-mix(in srgb, var(--forecast) 22%, transparent); }
  .k.tick { width: 0; height: 10px; border-top: 0; border-left: 2px solid var(--event); margin-inline: 8px; }
  .k.gap { border-top: 2px dotted var(--muted); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--s-4) var(--s-5); margin: var(--s-5) 0 0; padding-top: var(--s-5); border-top: 1px solid var(--line); }
  .facts .wide { grid-column: 1 / -1; }
  dt { color: var(--muted); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2px; }
  dd { margin: 0; color: var(--ink); font-size: var(--text-sm); line-height: 1.55; }
  dd a { color: var(--accent-ink); }
  .reasons { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  code { font-family: var(--font-mono); font-size: 12px; padding: 1px 6px; border-radius: 5px; background: var(--panel); color: var(--ink-2); }
  .tbl { margin-top: var(--s-4); }
  .tbl summary { cursor: pointer; color: var(--accent-ink); font-size: var(--text-sm); min-height: 32px; display: inline-flex; align-items: center; }
  .scroll { overflow-x: auto; margin-top: var(--s-2); border: 1px solid var(--line); border-radius: var(--radius); }
  table { width: 100%; border-collapse: collapse; font-size: 13px; }
  th, td { padding: 6px 10px; text-align: right; white-space: nowrap; border-bottom: 1px solid var(--line); }
  thead th { text-align: right; color: var(--muted); font-weight: 600; background: var(--panel); position: sticky; top: 0; }
  tbody th { text-align: left; font-weight: 500; color: var(--ink-2); }
  thead th:first-child { text-align: left; }
  .fcrow { background: color-mix(in srgb, var(--forecast) 6%, transparent); }
  tr:last-child > * { border-bottom: 0; }
</style>
