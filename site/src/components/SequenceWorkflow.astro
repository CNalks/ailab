---
// "Pick a series, walk through the checks": a step-by-step replay of the recorded gate result for one real series.
// All values come from site/public/data at build time (src/lib/workflow.ts fails the build on any inconsistency);
// the script only reveals pre-rendered steps. Without JS every run is listed in full.
// Global styles under .wf keep the HTML small (no per-element scope attributes).
import { runs, type StepState } from "../lib/workflow";
import { asset, msgKey, type Locale } from "../i18n/config";
import { t, type MessageKey } from "../i18n";
import { formatDate, formatNumber } from "../i18n/format";

interface Props { locale: Locale }
const { locale } = Astro.props;
const mk = msgKey[locale];
const st = (s: StepState) => t(locale, `wf.st.${s}` as MessageKey);
const items = runs().map((r) => {
  const q = r.res.quality;
  const bt = r.res.backtest;
  const g = r.res.gate;
  const name = t(locale, `s.${r.id}.n` as MessageKey);
  const dec = t(locale, `wf.d.${r.decision}` as MessageKey);
  const outcome =
    r.decision === "limited"
      ? t(locale, "gate.limited.s", { h: g.limits.max_horizon_weeks ?? "–", infl: formatNumber(locale, g.limits.interval_inflation, 2) })
      : t(locale, `gate.${r.decision}.s` as MessageKey);
  return {
    ...r, name, dec, outcome,
    s1: t(locale, "wf.s1.d", { n: q.n_weeks, from: formatDate(locale, q.data_from), to: formatDate(locale, q.data_through), miss: q.n_missing }),
    s3: bt ? t(locale, "wf.s3.d", { n: bt.n_windows, seasons: formatNumber(locale, bt.seasons_covered, 1) }) : "",
    skill: r.skill
      ? t(locale, "wf.s3.skill", { model: r.skill.model, rel: formatNumber(locale, r.skill.rel, 2), max: formatNumber(locale, r.skill.maxRel, 2) }) +
        (r.skill.cov80 != null ? `; ${t(locale, "wf.s3.cov", { cov: formatNumber(locale, r.skill.cov80 * 100, 0) })}` : "")
      : "",
    act: g.recommended_action.code !== "none" ? g.recommended_action.message[mk] : ""
  };
});
---

<script is:inline>document.documentElement.classList.add("wf-js")</script>
<section class="wf" id="workflow" aria-labelledby="wf-t" data-wf data-need={t(locale, "wf.need")} data-step={t(locale, "wf.step")} data-done={t(locale, "wf.done")}>
  <div class="container">
    <h2 id="wf-t">{t(locale, "wf.title")}</h2>
    <p class="wf-lead">{t(locale, "wf.lead")}</p>
    <noscript><p class="wf-note">{t(locale, "wf.nojs")}</p></noscript>
    <form class="wf-form" novalidate>
      <fieldset>
        <legend>{t(locale, "wf.pick")}</legend>
        {items.map((r) => (
          <label><input type="radio" name="wf-s" value={r.id} /><span>{r.name}</span></label>
        ))}
      </fieldset>
      <button type="submit">{t(locale, "wf.run")}</button>
      <p class="wf-status" role="status" aria-live="polite" data-wf-status></p>
    </form>
    {items.map((r) => (
      <article class="run" data-series={r.id} data-decision={r.decision}>
        <h3><span>{r.name}</span></h3>
        <ol class="steps">
          <li data-state="pass"><h4>{t(locale, "wf.s1")}</h4><b>{st("pass")}</b><div class="bd">{r.s1}</div></li>
          <li data-state={r.data.state}><h4>{t(locale, "wf.s2")}</h4><b>{st(r.data.state)}</b><div class="bd">
            {r.data.reasons.length === 0 ? t(locale, "wf.none") : (
              <ul>{r.data.reasons.map((x) => <li><code>{x.code}</code> <i>{x.severity}</i> {x.message[mk]}</li>)}</ul>
            )}
          </div></li>
          <li data-state={r.backtest.state}><h4>{t(locale, "wf.s3")}</h4><b>{st(r.backtest.state)}</b><div class="bd">
            {r.backtest.state === "skip" ? t(locale, "wf.s3.skip") : (
              <>
                <p>{r.s3}</p>
                <p>{r.skill || t(locale, "wf.s3.nomodel")}</p>
                {r.backtest.reasons.length > 0 && <ul>{r.backtest.reasons.map((x) => <li><code>{x.code}</code> <i>{x.severity}</i> {x.message[mk]}</li>)}</ul>}
              </>
            )}
          </div></li>
          <li data-state={r.decision}><h4>{t(locale, "wf.s4")}</h4><b class="dec">{r.dec}</b><div class="bd">
            <p>{r.outcome}{r.act && <> · {t(locale, "wf.act")}: {r.act}</>}</p>
            <p class="pol"><code>forecast_allowed: {String(r.forecastAllowed)}</code> <code>reason: {r.reason}</code> <code>reason_codes: [{r.reasonCodes.join(", ")}]</code></p>
            <p class="go"><a href={`#s-${r.id}`}>{t(locale, "wf.goto")} ↓</a></p>
          </div></li>
        </ol>
      </article>
    ))}
    <p class="rl">{t(locale, "wf.repro")}</p>
    <pre tabindex="0"><code>{`uv run python scripts/build_showcase_data.py\njq '.gate | {decision, reason_codes}' \\\n  site/public/data/series/<series_id>.json`}</code></pre>
    <p class="go"><a href={asset("/data/manifest.json")}>{t(locale, "wf.json")}</a></p>
    <p class="wf-note">{t(locale, "wf.caveat")}</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-wf]");
  const form = root?.querySelector("form");
  if (root && form) {
    const status = root.querySelector<HTMLElement>("[data-wf-status]")!;
    const btn = form.querySelector("button")!;
    const runs = [...root.querySelectorAll<HTMLElement>(".run")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const fill = (s: string, p: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(p[k]));
    let token = 0;
    const show = (id?: string) => runs.forEach((r) => r.classList.toggle("on", r.dataset.series === id));
    form.addEventListener("change", () => {
      token++;
      show();
      btn.removeAttribute("aria-disabled");
      status.textContent = "";
    });
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (btn.getAttribute("aria-disabled")) return;
      const sel = form.querySelector<HTMLInputElement>("input:checked");
      if (!sel) {
        status.textContent = root.dataset.need!;
        form.querySelector("input")?.focus();
        return;
      }
      const my = ++token;
      const run = runs.find((r) => r.dataset.series === sel.value)!;
      const steps = [...run.querySelectorAll<HTMLElement>(".steps > li")];
      steps.forEach((s) => { s.dataset.s = "wait"; s.removeAttribute("aria-current"); });
      show(sel.value);
      run.setAttribute("aria-busy", "true");
      btn.setAttribute("aria-disabled", "true");
      for (const [i, s] of steps.entries()) {
        s.dataset.s = "run";
        s.setAttribute("aria-current", "step");
        status.textContent = fill(root.dataset.step!, { i: i + 1, n: steps.length, step: s.querySelector("h4")!.textContent! });
        if (!reduce) await new Promise((r) => setTimeout(r, 450));
        if (my !== token) return;
        s.dataset.s = "done";
        s.removeAttribute("aria-current");
      }
      run.removeAttribute("aria-busy");
      btn.removeAttribute("aria-disabled");
      status.textContent = fill(root.dataset.done!, { name: run.querySelector("h3 span")!.textContent!, decision: run.querySelector(".dec")!.textContent! });
    });
  }
</script>

<style is:global>
  .wf { padding: clamp(40px, 6vw, 72px) 0; }
  .wf h2 { font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .wf-lead { margin-top: var(--s-3); color: var(--ink-2); max-width: 72ch; }
  .wf-note { margin-top: var(--s-4); color: var(--muted); font-size: var(--text-sm); max-width: 80ch; }
  .wf-form { display: none; margin-top: var(--s-5); }
  .wf-js .wf-form { display: block; }
  .wf fieldset { margin: 0; padding: var(--s-4); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-elev); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--s-2); }
  .wf legend { padding: 0 var(--s-2); font-size: var(--text-sm); font-weight: 600; }
  .wf label { display: grid; grid-template-columns: auto 1fr; column-gap: var(--s-2); align-items: baseline; padding: var(--s-2) var(--s-3); border: 1px solid var(--line); border-radius: var(--radius); cursor: pointer; font-size: var(--text-sm); }
  .wf label:has(:checked) { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .wf input { accent-color: var(--accent); }
  .wf-form button { margin-top: var(--s-4); min-height: 44px; padding: 0 22px; border: 0; border-radius: var(--radius-pill); font: 600 15px var(--font-sans); color: var(--on-accent); background: var(--accent); cursor: pointer; }
  .wf-form button:hover { background: var(--accent-hover); }
  .wf-form button:focus-visible, .wf label:has(:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wf-form button[aria-disabled] { opacity: 0.6; cursor: progress; }
  .wf-status { display: inline-block; margin-left: var(--s-3); color: var(--ink-2); font-size: var(--text-sm); font-family: var(--font-mono); }
  .wf .run { margin-top: var(--s-5); padding: clamp(16px, 2.6vw, 24px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-elev); }
  .wf-js .wf .run:not(.on) { display: none; }
  .wf .run h3 { font-size: var(--text-lg); }
  .wf i { color: var(--muted); font-size: var(--text-xs); font-style: normal; font-weight: 400; }
  .wf .steps { list-style: none; margin: var(--s-4) 0 0; padding: 0; counter-reset: st; }
  .wf .steps > li { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-3); padding: 0 0 var(--s-4) 34px; border-left: 1px solid var(--line); margin-left: 11px; }
  .wf .steps > li:last-child { border-left-color: transparent; padding-bottom: 0; }
  .wf .steps > li::before { counter-increment: st; content: counter(st); position: absolute; left: -12px; top: -1px; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font: 600 12px/1 var(--font-mono); background: var(--panel); border: 1px solid var(--line-strong); color: var(--ink-2); }
  .wf h4 { font-size: var(--text-base); }
  .wf .steps b { font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink-2); }
  .wf [data-state="block"] > b, .wf [data-state="refused"] > b { border-style: dashed; }
  .wf [data-state="allowed"] > b { color: var(--on-data); background: var(--data); border-color: transparent; }
  .wf [data-state="limit"] > b, .wf [data-state="limited"] > b { border-color: var(--forecast); }
  .wf .bd { flex-basis: 100%; min-width: 0; margin-top: var(--s-1); color: var(--ink-2); font-size: var(--text-sm); line-height: 1.6; overflow-wrap: anywhere; }
  .wf .bd ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .wf .bd p + p, .wf .bd p + ul { margin-top: 2px; }
  .wf code { font-family: var(--font-mono); font-size: 12px; padding: 1px 5px; border-radius: 5px; background: var(--panel); color: var(--ink-2); }
  .wf .pol { margin-top: var(--s-3); display: flex; flex-wrap: wrap; gap: 4px; }
  .wf .pol code { min-width: 0; overflow-wrap: anywhere; }
  .wf .rl { margin-top: var(--s-4); color: var(--muted); font-size: var(--text-xs); }
  .wf pre { margin: var(--s-1) 0 0; padding: var(--s-3); overflow-x: auto; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); font: 12px/1.6 var(--font-mono); }
  .wf pre code { padding: 0; background: none; }
  .wf .go { margin-top: var(--s-3); display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .wf .go a { color: var(--accent-ink); font-weight: 600; }
  .wf-js .wf [data-s="wait"] { opacity: 0.45; }
  .wf-js .wf [data-s="wait"] > b, .wf-js .wf [data-s="wait"] > .bd, .wf-js .wf [data-s="run"] > b, .wf-js .wf [data-s="run"] > .bd { display: none; }
  .wf-js .wf [data-s="run"]::before { border-color: var(--accent); color: var(--accent-ink); }
  .wf-js .wf [data-s="run"] > h4::after { content: " …"; color: var(--muted); }
</style>
