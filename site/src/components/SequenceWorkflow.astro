---
// "You already have a series": history chart first; primary action is Forecast.
// Click reveals precomputed forecast (± bands) + decision badge. Switch series is secondary.
// Values from site/public/data at build time (workflow.ts fails the build on inconsistency).
import SeriesChart from "./SeriesChart.astro";
import { runs, type StepState } from "../lib/workflow";
import { asset, msgKey, type Locale } from "../i18n/config";
import { t, type MessageKey } from "../i18n";
import { formatDate, formatNumber } from "../i18n/format";

interface Props { locale: Locale }
const { locale } = Astro.props;
const mk = msgKey[locale];
const st = (s: StepState) => t(locale, `wf.st.${s}` as MessageKey);
const items = runs().map((r) => {
  const q = r.res.quality;
  const bt = r.res.backtest;
  const g = r.res.gate;
  const name = t(locale, `s.${r.id}.n` as MessageKey);
  const dec = t(locale, `wf.d.${r.decision}` as MessageKey);
  const gateLabel = t(locale, `gate.${r.decision}` as MessageKey);
  const horizon = r.decision === "limited"
    ? (g.limits.max_horizon_weeks ?? r.res.policy.horizon_weeks)
    : r.res.policy.horizon_weeks;
  const outcome =
    r.decision === "limited"
      ? t(locale, "gate.limited.s", { h: g.limits.max_horizon_weeks ?? "–", infl: formatNumber(locale, g.limits.interval_inflation, 2) })
      : t(locale, `gate.${r.decision}.s` as MessageKey);
  const runLabel = horizon > 0 ? t(locale, "wf.run.h", { h: horizon }) : t(locale, "wf.run");
  return {
    ...r, name, dec, gateLabel, outcome, horizon, runLabel,
    s1: t(locale, "wf.s1.d", { n: q.n_weeks, from: formatDate(locale, q.data_from), to: formatDate(locale, q.data_through), miss: q.n_missing }),
    s3: bt ? t(locale, "wf.s3.d", { n: bt.n_windows, seasons: formatNumber(locale, bt.seasons_covered, 1) }) : "",
    skill: r.skill
      ? t(locale, "wf.s3.skill", { model: r.skill.model, rel: formatNumber(locale, r.skill.rel, 2), max: formatNumber(locale, r.skill.maxRel, 2) }) +
        (r.skill.cov80 != null ? `; ${t(locale, "wf.s3.cov", { cov: formatNumber(locale, r.skill.cov80 * 100, 0) })}` : "")
      : "",
    act: g.recommended_action.code !== "none" ? g.recommended_action.message[mk] : ""
  };
});
---

<script is:inline>document.documentElement.classList.add("wf-js")</script>
<section class="wf" id="workflow" aria-labelledby="wf-t" data-wf data-done={t(locale, "wf.done")}>
  <div class="container">
    <h2 id="wf-t">{t(locale, "wf.title")}</h2>
    <p class="wf-lead">{t(locale, "wf.lead")}</p>
    <noscript><p class="wf-note">{t(locale, "wf.nojs")}</p></noscript>

    <form class="wf-form" novalidate>
      <div class="series-bar">
        <label class="switch">
          <span class="switch-l">{t(locale, "wf.switch")}</span>
          <select name="wf-s" data-wf-select aria-label={t(locale, "wf.switch")}>
            {items.map((r, i) => (
              <option value={r.id} selected={i === 0}>{r.name}</option>
            ))}
          </select>
        </label>
      </div>
      <p class="wf-status" role="status" aria-live="polite" data-wf-status></p>
    </form>

    {items.map((r, i) => (
      <article class:list={["run", i === 0 && "on"]} data-series={r.id} data-decision={r.decision} data-name={r.name} data-dec={r.dec}>
        <header class="head">
          <div>
            <p class="now">{t(locale, "wf.have")}</p>
            <h3><span>{r.name}</span></h3>
          </div>
          <span class="badge after-fc" data-gate={r.decision}>
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
              {r.decision === "allowed" && <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
              {r.decision === "limited" && <path d="M8 2.5a5.5 5.5 0 100 11z" fill="currentColor" />}
              {r.decision === "limited" && <circle cx="8" cy="8" r="5.5" fill="none" stroke="currentColor" stroke-width="1.5" />}
              {r.decision === "refused" && <path d="M4 8h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />}
            </svg>
            {r.dec}
          </span>
        </header>

        <div class="chartbox">
          <div class="hist-view">
            <SeriesChart res={r.res} locale={locale} name={r.name} gateLabel={r.gateLabel} compact historyOnly />
          </div>
          {r.forecastAllowed && (
            <div class="fc-view">
              <SeriesChart res={r.res} locale={locale} name={r.name} gateLabel={r.gateLabel} compact />
            </div>
          )}
          {!r.forecastAllowed && <p class="nofc after-fc">{t(locale, "series.noforecast")}</p>}
        </div>

        <ul class="legend" role="list">
          <li><i class="k hist"></i>{t(locale, "chart.history")}</li>
          {r.forecastAllowed && <li class="after-fc fc-leg"><i class="k fc"></i>{t(locale, "chart.forecast")}</li>}
          {r.forecastAllowed && <li class="after-fc fc-leg"><i class="k band"></i>{t(locale, "chart.band80")} / {t(locale, "chart.band95")}</li>}
        </ul>

        <div class="pre-fc actions">
          <button type="button" data-wf-run>{r.runLabel}</button>
          <p class="hint">{t(locale, "wf.hint")}</p>
        </div>

        <div class="after-fc result">
          <p class="out">{r.outcome}{r.act && <> · {t(locale, "wf.act")}: {r.act}</>}</p>
          <details class="basis">
            <summary>{t(locale, "wf.basis")}</summary>
            <ol class="steps">
              <li data-state="pass"><h4>{t(locale, "wf.s1")}</h4><b>{st("pass")}</b><div class="bd">{r.s1}</div></li>
              <li data-state={r.data.state}><h4>{t(locale, "wf.s2")}</h4><b>{st(r.data.state)}</b><div class="bd">
                {r.data.reasons.length === 0 ? t(locale, "wf.none") : (
                  <ul>{r.data.reasons.map((x) => <li><code>{x.code}</code> <i>{x.severity}</i> {x.message[mk]}</li>)}</ul>
                )}
              </div></li>
              <li data-state={r.backtest.state}><h4>{t(locale, "wf.s3")}</h4><b>{st(r.backtest.state)}</b><div class="bd">
                {r.backtest.state === "skip" ? t(locale, "wf.s3.skip") : (
                  <>
                    <p>{r.s3}</p>
                    <p>{r.skill || t(locale, "wf.s3.nomodel")}</p>
                    {r.backtest.reasons.length > 0 && <ul>{r.backtest.reasons.map((x) => <li><code>{x.code}</code> <i>{x.severity}</i> {x.message[mk]}</li>)}</ul>}
                  </>
                )}
              </div></li>
              <li data-state={r.decision}><h4>{t(locale, "wf.s4")}</h4><b class="dec">{r.dec}</b><div class="bd">
                <p class="pol"><code>forecast_allowed: {String(r.forecastAllowed)}</code> <code>reason: {r.reason}</code> <code>reason_codes: [{r.reasonCodes.join(", ")}]</code></p>
              </div></li>
            </ol>
          </details>
          <p class="go"><a href={`#s-${r.id}`}>{t(locale, "wf.goto")} ↓</a></p>
        </div>
      </article>
    ))}

    <details class="repro">
      <summary>{t(locale, "wf.repro")}</summary>
      <pre tabindex="0"><code>{`uv run python scripts/build_showcase_data.py\njq '.gate | {decision, reason_codes}' \\\n  site/public/data/series/<series_id>.json`}</code></pre>
      <p class="go"><a href={asset("/data/manifest.json")}>{t(locale, "wf.json")}</a></p>
    </details>
    <p class="wf-note">{t(locale, "wf.caveat")}</p>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-wf]");
  if (root) {
    const status = root.querySelector<HTMLElement>("[data-wf-status]")!;
    const select = root.querySelector<HTMLSelectElement>("[data-wf-select]");
    const runs = [...root.querySelectorAll<HTMLElement>(".run")];
    const fill = (s: string, p: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(p[k]));
    const show = (id: string) => {
      runs.forEach((r) => {
        const on = r.dataset.series === id;
        r.classList.toggle("on", on);
        if (on) r.classList.remove("fc-on");
      });
      status.textContent = "";
    };
    const forecast = (run: HTMLElement) => {
      run.classList.add("fc-on");
      status.textContent = fill(root.dataset.done!, {
        name: run.dataset.name!,
        decision: run.dataset.dec!
      });
    };
    if (select) {
      show(select.value);
      select.addEventListener("change", () => show(select.value));
    }
    root.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-wf-run]");
      if (!btn) return;
      const run = btn.closest<HTMLElement>(".run");
      if (run) forecast(run);
    });
  }
</script>

<style is:global>
  .wf { padding: clamp(40px, 6vw, 72px) 0; }
  .wf h2 { font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .wf-lead { margin-top: var(--s-3); color: var(--ink-2); max-width: 72ch; }
  .wf-note { margin-top: var(--s-4); color: var(--muted); font-size: var(--text-sm); max-width: 80ch; }
  .wf-form { display: none; margin-top: var(--s-5); }
  .wf-js .wf-form { display: block; }
  .wf .series-bar { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: flex-end; }
  .wf .switch { display: grid; gap: 4px; font-size: var(--text-sm); min-width: min(100%, 320px); }
  .wf .switch-l { color: var(--muted); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; font-weight: 600; }
  .wf select {
    min-height: 40px; padding: 0 12px; border: 1px solid var(--line-strong); border-radius: var(--radius);
    background: var(--bg-elev); color: var(--ink); font: 500 14px var(--font-sans); max-width: 100%;
  }
  .wf select:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wf-status { margin-top: var(--s-3); color: var(--ink-2); font-size: var(--text-sm); font-family: var(--font-mono); min-height: 1.2em; }
  .wf .run { margin-top: var(--s-5); padding: clamp(16px, 2.6vw, 24px); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--bg-elev); }
  .wf-js .wf .run:not(.on) { display: none; }
  .wf .head { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-4); justify-content: space-between; align-items: flex-start; }
  .wf .now { color: var(--muted); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; }
  .wf .run h3 { font-size: var(--text-lg); margin-top: 2px; }
  .wf .badge {
    display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px;
    font-size: 13px; font-weight: 600; white-space: nowrap; border: 1px solid transparent;
  }
  .wf .badge[data-gate="allowed"] { color: var(--on-data); background: var(--data); }
  .wf .badge[data-gate="limited"] { color: var(--indigo); background: color-mix(in srgb, var(--indigo) 12%, transparent); border-color: color-mix(in srgb, var(--indigo) 40%, transparent); }
  .wf .badge[data-gate="refused"] { color: var(--ink-2); background: var(--panel); border-color: var(--line-strong); }
  .wf .chartbox { position: relative; margin-top: var(--s-4); }
  .wf .fc-view { display: none; }
  .wf .nofc:empty { display: none; }
  .wf .nofc { margin-top: var(--s-2); color: var(--muted); font-size: var(--text-sm); }
  .wf .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: var(--s-3) 0 0; padding: 0; list-style: none; color: var(--muted); font-size: 12px; }
  .wf .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .wf .k { display: inline-block; width: 18px; height: 0; border-top: 2px solid var(--data); }
  .wf .k.fc { border-top: 2px dashed var(--forecast); }
  .wf .k.band { height: 10px; width: 18px; border: 0; border-radius: 3px; background: color-mix(in srgb, var(--forecast) 22%, transparent); }
  .wf .actions { margin-top: var(--s-4); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3); }
  .wf .actions button {
    min-height: 44px; padding: 0 22px; border: 0; border-radius: var(--radius-pill);
    font: 600 15px var(--font-sans); color: var(--on-accent); background: var(--accent); cursor: pointer;
  }
  .wf .actions button:hover { background: var(--accent-hover); }
  .wf .actions button:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .wf .hint { color: var(--muted); font-size: var(--text-sm); margin: 0; }
  .wf .out { margin-top: var(--s-3); color: var(--ink-2); font-size: var(--text-sm); max-width: 70ch; }
  .wf i { color: var(--muted); font-size: var(--text-xs); font-style: normal; font-weight: 400; }
  .wf .basis, .wf .repro { margin-top: var(--s-4); }
  .wf .basis summary, .wf .repro summary { cursor: pointer; color: var(--accent-ink); font-size: var(--text-sm); font-weight: 600; min-height: 32px; display: inline-flex; align-items: center; }
  .wf .steps { list-style: none; margin: var(--s-3) 0 0; padding: 0; counter-reset: st; }
  .wf .steps > li { position: relative; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-3); padding: 0 0 var(--s-4) 34px; border-left: 1px solid var(--line); margin-left: 11px; }
  .wf .steps > li:last-child { border-left-color: transparent; padding-bottom: 0; }
  .wf .steps > li::before { counter-increment: st; content: counter(st); position: absolute; left: -12px; top: -1px; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; font: 600 12px/1 var(--font-mono); background: var(--panel); border: 1px solid var(--line-strong); color: var(--ink-2); }
  .wf h4 { font-size: var(--text-base); }
  .wf .steps b { font-size: 12px; font-weight: 600; padding: 1px 8px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink-2); }
  .wf [data-state="block"] > b, .wf [data-state="refused"] > b { border-style: dashed; }
  .wf [data-state="allowed"] > b { color: var(--on-data); background: var(--data); border-color: transparent; }
  .wf [data-state="limit"] > b, .wf [data-state="limited"] > b { border-color: var(--forecast); }
  .wf .bd { flex-basis: 100%; min-width: 0; margin-top: var(--s-1); color: var(--ink-2); font-size: var(--text-sm); line-height: 1.6; overflow-wrap: anywhere; }
  .wf .bd ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  .wf .bd p + p, .wf .bd p + ul { margin-top: 2px; }
  .wf code { font-family: var(--font-mono); font-size: 12px; padding: 1px 5px; border-radius: 5px; background: var(--panel); color: var(--ink-2); }
  .wf .pol { display: flex; flex-wrap: wrap; gap: 4px; }
  .wf .pol code { min-width: 0; overflow-wrap: anywhere; }
  .wf pre { margin: var(--s-2) 0 0; padding: var(--s-3); overflow-x: auto; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); font: 12px/1.6 var(--font-mono); }
  .wf pre code { padding: 0; background: none; }
  .wf .go { margin-top: var(--s-3); display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .wf .go a { color: var(--accent-ink); font-weight: 600; font-size: var(--text-sm); }

  /* noJS default: post-forecast listing for every series */
  .wf .pre-fc { display: none; }
  .wf .hist-view { display: none; }
  .wf .fc-view { display: block; }
  .wf .run[data-decision="refused"] .hist-view { display: block; }

  /* JS before forecast: history + CTA only */
  .wf-js .wf .run:not(.fc-on) .pre-fc { display: flex; }
  .wf-js .wf .run:not(.fc-on) .hist-view { display: block; }
  .wf-js .wf .run:not(.fc-on) .fc-view { display: none; }
  .wf-js .wf .run:not(.fc-on) .after-fc { display: none !important; }

  /* JS after forecast */
  .wf-js .wf .run.fc-on .pre-fc { display: none; }
  .wf-js .wf .run.fc-on .hist-view { display: none; }
  .wf-js .wf .run.fc-on .fc-view { display: block; }
  .wf-js .wf .run.fc-on[data-decision="refused"] .hist-view { display: block; }
</style>
