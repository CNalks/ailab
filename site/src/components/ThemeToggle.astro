---
import { t } from "../i18n";
import type { Locale } from "../i18n/config";
interface Props { locale: Locale }
const { locale } = Astro.props;
---

<button type="button" class="theme" data-theme-toggle aria-pressed="false" aria-label={t(locale, "theme.toggle")} title={t(locale, "theme.toggle")}>
  <svg class="sun" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="3.6" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
  <svg class="moon" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M16.5 12.2A6.8 6.8 0 0 1 7.8 3.5a7 7 0 1 0 8.7 8.7z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
</button>

{/* Click handling lives in BaseLayout (one document-level listener); aria-pressed is true while the dark theme is active. */}

<style>
  .theme {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .theme:hover { color: var(--ink); background: var(--accent-soft); }
  .theme:focus-visible { border-radius: 999px; }
  .theme:active { transform: scale(var(--press-scale)); }
  :global(:root[data-theme="light"]) .sun { display: none; }
  :global(:root[data-theme="dark"]) .moon { display: none; }
</style>
