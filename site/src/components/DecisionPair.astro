---
// Two real gate decisions side by side (allowed vs refused), read from site/public/data at build time.
import { buildChart } from "../lib/chart";
import { decisionCards, firstLimited } from "../lib/decision";
import { SERIES_IDS } from "../lib/data";
import { asset, htmlLang, msgKey, type Locale } from "../i18n/config";
import { t, type MessageKey } from "../i18n";
import { formatNumber } from "../i18n/format";

interface Props { locale: Locale }
const { locale } = Astro.props;
const lang = htmlLang[locale];
const mk = msgKey[locale];
const cliLang = mk;
const limitedId = firstLimited(SERIES_IDS);

const cards = decisionCards().map((c) => {
  const r = c.res;
  // thumbnail: the same geometry code as the full chart, without signal lanes; a refused series has no forecast,
  // so nothing is drawn after the last observation and missing weeks stay gaps (never 0)
  const chart = buildChart({ ...r, alerts: [] }, { w: 320, h: 120, weeks: c.role === "allowed" ? 104 : 52, locale: lang, yearStep: 1 });
  const bt = r.backtest;
  const rel = bt?.models?.[bt.chosen_model]?.rel_mae_vs_seasonal_naive;
  const cov80 = r.forecast?.calibration?.["80"]?.empirical_loo;
  const observed = r.quality.n_weeks - r.quality.n_missing;
  const evidence =
    c.role === "allowed" && bt && rel != null
      ? t(locale, "dp.ev.allowed", {
          n: bt.n_windows, seasons: formatNumber(locale, bt.seasons_covered, 1), rel: formatNumber(locale, rel, 2),
          cov: cov80 != null ? formatNumber(locale, cov80 * 100, 0) : "–", h: r.policy.horizon_weeks
        })
      : t(locale, "dp.ev.refused", { obs: observed, n: r.quality.n_weeks });
  const repro =
    c.role === "allowed"
      ? `ailab gate ${c.id} --lang ${cliLang}\ncurl -s \\\n  127.0.0.1:8000/api/v1/series/${c.id}/policy`
      : `uv run python scripts/build_showcase_data.py\njq '.policy, .gate.reason_codes' \\\n  site/public/data/series/${c.id}.json`;
  return { ...c, chart, evidence, repro, name: t(locale, `s.${c.id}.n` as MessageKey), geo: t(locale, `s.${c.id}.g` as MessageKey) };
});
---

<section class="dp" id="decisions" aria-labelledby="dp-title">
  <div class="container">
    <h2 id="dp-title">{t(locale, "dp.title")}</h2>
    <p class="lead">{t(locale, "dp.lead")}</p>
    <div class="pair">
      {cards.map((c) => (
        <article class="dc" data-series={c.id} data-decision={c.decision} data-forecast-allowed={String(c.forecastAllowed)}
          data-reason={c.reason} data-reason-codes={c.reasonCodes.join(",")} aria-labelledby={`dp-h-${c.id}`}>
          <header class="dh">
            <div>
              <p class="geo">{c.geo}</p>
              <h3 id={`dp-h-${c.id}`}>{c.name}</h3>
            </div>
            <span class="gate" data-gate={c.decision}>
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                {c.decision === "allowed" && <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />}
                {c.decision === "refused" && <path d="M4 8h8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />}
              </svg>
              {t(locale, `dp.status.${c.decision}` as MessageKey)}
            </span>
          </header>
          {c.role === "refused" && <p class="tag">{t(locale, "dp.lowq")}</p>}
          <svg class="thumb" viewBox={`0 0 ${c.chart.w} ${c.chart.h}`} role="img" focusable="false"
            aria-label={t(locale, "chart.alt", { name: c.name, through: c.res.data_through, gate: t(locale, `gate.${c.decision}` as MessageKey) })}>
            <g class="grid">{c.chart.yTicks.map((y) => (<line x1={c.chart.plot.l} x2={c.chart.plot.r} y1={y.y} y2={y.y} />))}</g>
            <g class="lab">
              {c.chart.yTicks.map((y) => (<text x={c.chart.plot.l - 5} y={y.y + 3.5} text-anchor="end">{y.label}</text>))}
              {c.chart.xTicks.map((x) => (<text x={x.x} y={c.chart.plot.b + 13} text-anchor="middle">{x.label}</text>))}
            </g>
            {c.chart.band80 && <path class="b80" d={c.chart.band80} />}
            {c.chart.hist && <path class="hist" d={c.chart.hist} />}
            {c.chart.dots.map((d) => (<circle class="dot" cx={d.x} cy={d.y} r="2.2" />))}
            {c.chart.fc && <path class="fc" d={c.chart.fc} />}
          </svg>
          <p class="cap">{c.forecastAllowed ? t(locale, "dp.cap.allowed") : t(locale, "dp.cap.refused")}</p>
          <dl class="pol">
            <div><dt><code>forecast_allowed</code></dt><dd><code>{String(c.forecastAllowed)}</code></dd></div>
            <div><dt><code>reason</code></dt><dd><code>{c.reason}</code></dd></div>
            <div class="w"><dt><code>reason_codes</code></dt><dd>
              {c.reasonCodes.length === 0 ? <span><code>[]</code> {t(locale, "series.noreasons")}</span> : (
                <ul role="list">{c.res.gate.reasons.map((r) => (<li><code>{r.code}</code> {r.message[mk]}</li>))}</ul>
              )}
            </dd></div>
            <div class="w"><dt>{t(locale, "dp.evidence")}</dt><dd>{c.evidence}</dd></div>
          </dl>
          <p class="rl">{t(locale, "dp.repro")}</p>
          <pre tabindex="0"><code>{c.repro}</code></pre>
          <p class="go">
            <a href={`#s-${c.id}`}>{t(locale, "dp.goto")} ↓</a>
            <a href={asset(`/data/series/${c.id}.json`)}>{t(locale, "dp.json")}</a>
          </p>
        </article>
      ))}
    </div>
    {limitedId && <p class="note">{t(locale, "dp.limited")} <a href={`#s-${limitedId}`}>{t(locale, `s.${limitedId}.n` as MessageKey)}</a></p>}
    <p class="note warn">{t(locale, "dp.caveat")}</p>
  </div>
</section>

<style>
  .dp { padding: clamp(40px, 6vw, 72px) 0; }
  h2 { font-size: var(--text-2xl); letter-spacing: -0.02em; }
  .lead { margin-top: var(--s-3); color: var(--ink-2); max-width: 72ch; }
  .pair { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: var(--s-5); margin-top: var(--s-5); }
  .dc { min-width: 0; display: flex; flex-direction: column; padding: clamp(16px, 2.6vw, 24px); border-radius: var(--radius-lg); background: var(--bg-elev); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .dc[data-decision="refused"] { border-style: dashed; border-color: var(--line-strong); }
  .dh { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); justify-content: space-between; align-items: flex-start; }
  .geo { color: var(--muted); font-size: var(--text-xs); letter-spacing: 0.04em; text-transform: uppercase; }
  h3 { font-size: var(--text-lg); letter-spacing: -0.01em; margin-top: 2px; }
  .gate { display: inline-flex; align-items: center; gap: 6px; padding: 4px 11px; border-radius: 999px; font-size: 13px; font-weight: 600; white-space: nowrap; border: 1px solid transparent; }
  .gate[data-gate="allowed"] { color: var(--on-data); background: var(--data); }
  .gate[data-gate="refused"] { color: var(--ink-2); background: var(--panel); border-color: var(--line-strong); }
  .tag { align-self: flex-start; margin-top: var(--s-2); padding: 2px 8px; border-radius: 6px; font-size: 12px; font-weight: 600; color: var(--ink-2); background: var(--panel); border: 1px dashed var(--line-strong); }
  .thumb { width: 100%; height: auto; margin-top: var(--s-4); }
  .grid line { stroke: var(--line); stroke-width: 1; }
  .lab text { fill: var(--muted); font-size: 10px; font-family: var(--font-sans); font-variant-numeric: tabular-nums; }
  .hist { fill: none; stroke: var(--data); stroke-width: 1.5; stroke-linejoin: round; }
  .dot { fill: var(--data); }
  .fc { fill: none; stroke: var(--forecast); stroke-width: 1.6; stroke-dasharray: 4 3; }
  .b80 { fill: var(--forecast); opacity: 0.18; }
  .cap { margin-top: var(--s-1); color: var(--muted); font-size: var(--text-xs); }
  .pol { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: var(--s-3) var(--s-4); margin: var(--s-4) 0 0; padding-top: var(--s-4); border-top: 1px solid var(--line); }
  .pol .w { grid-column: 1 / -1; }
  dt { color: var(--muted); font-size: var(--text-xs); margin-bottom: 2px; }
  dd { margin: 0; font-size: var(--text-sm); line-height: 1.55; color: var(--ink); overflow-wrap: anywhere; }
  dd ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 4px; }
  code { font-family: var(--font-mono); font-size: 12px; padding: 1px 5px; border-radius: 5px; background: var(--panel); color: var(--ink-2); }
  dt code { background: none; padding: 0; color: var(--muted); }
  .rl { margin-top: var(--s-4); color: var(--muted); font-size: var(--text-xs); }
  pre { margin: var(--s-1) 0 0; padding: var(--s-3) var(--s-4); overflow-x: auto; border-radius: var(--radius); background: var(--panel); border: 1px solid var(--line); font-family: var(--font-mono); font-size: 12px; line-height: 1.6; }
  pre code { padding: 0; background: none; }
  .go { margin-top: auto; padding-top: var(--s-4); display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--text-sm); }
  .go a { color: var(--accent-ink); font-weight: 600; }
  .note { margin-top: var(--s-4); color: var(--ink-2); font-size: var(--text-sm); max-width: 80ch; }
  .note a { color: var(--accent-ink); }
  .warn { color: var(--muted); }
</style>
