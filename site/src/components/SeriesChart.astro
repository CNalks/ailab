---
import { buildChart } from "../lib/chart";
import type { SeriesResult } from "../lib/data";
import { htmlLang, type Locale } from "../i18n/config";
import { t } from "../i18n";

interface Props {
  res: SeriesResult;
  locale: Locale;
  name: string;
  gateLabel: string;
}
// walkthrough chart: last 104 weeks, history + forecast bands, no signal lanes
const { res, locale, name, gateLabel } = Astro.props;
const lang = htmlLang[locale];
const c = buildChart({ ...res, alerts: [] }, {
  w: 640,
  h: 220,
  weeks: 104,
  locale: lang,
  yearStep: 1
});
const alt = t(locale, "chart.alt", { name, through: res.data_through, gate: gateLabel });
---

<svg class="chart" viewBox={`0 0 ${c.w} ${c.h}`} role="img" aria-label={alt} focusable="false">
  <title>{alt}</title>
  <g class="grid">
    {c.yTicks.map((y) => (<line x1={c.plot.l} x2={c.plot.r} y1={y.y} y2={y.y} />))}
  </g>
  <g class="ylab">
    {c.yTicks.map((y) => (<text x={c.plot.l - 6} y={y.y + 4} text-anchor="end">{y.label}</text>))}
  </g>
  <g class="xlab">
    {c.xTicks.map((x) => (<text x={x.x} y={c.plot.b + 14} text-anchor="middle">{x.label}</text>))}
  </g>
  {c.band95 && <path class="b95" d={c.band95} />}
  {c.band80 && <path class="b80" d={c.band80} />}
  {c.hist && <path class="hist" d={c.hist} />}
  {c.dots.map((d) => (<circle class="dot" cx={d.x} cy={d.y} r="2.4" />))}
  {c.fc && <path class="fc" d={c.fc} />}
  {c.last && <circle class="last" cx={c.last.x} cy={c.last.y} r="3.4" />}
</svg>

<style is:global>
  /* global (prefixed with .chart) instead of scoped: avoids a data-astro-cid attribute on every SVG node (~13 KB per page) */
  .chart { width: 100%; height: auto; overflow: visible; }
  .chart .grid line { stroke: var(--line); stroke-width: 1; }
  .chart .ylab text, .chart .xlab text { fill: var(--muted); font-size: 11px; font-family: var(--font-sans); font-variant-numeric: tabular-nums; }
  .chart .hist { fill: none; stroke: var(--data); stroke-width: 1.6; stroke-linejoin: round; stroke-linecap: round; }
  .chart .dot { fill: var(--data); }
  .chart .fc { fill: none; stroke: var(--forecast); stroke-width: 1.8; stroke-dasharray: 5 3; stroke-linecap: round; }
  .chart .b95 { fill: var(--forecast); opacity: 0.12; }
  .chart .b80 { fill: var(--forecast); opacity: 0.2; }
  .chart .last { fill: var(--event); stroke: var(--bg-elev); stroke-width: 1.5; }
</style>
